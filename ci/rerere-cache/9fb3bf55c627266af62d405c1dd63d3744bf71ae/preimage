# .github/workflows/js-tests.yml
name: JS Tests

on:
  workflow_call:
    inputs:
      commit:
        description: Commit to test and build. Empty keeps the triggering commit.
        type: string
        default: ''

# Fork: upstream runs every check in one job on a 32-core larger runner
# (via .github/scripts/run-workspace-checks.mjs). Larger runners never resolve
# on a personal account, so the fork keeps the matrix shape on standard
# runners: one job per check, with the same selection rule (``check:*``
# sub-scripts of a package, else its ``check``).
jobs:
  workspaces:
    name: List npm workspaces
    runs-on: ubuntu-latest
    timeout-minutes: 20
    outputs:
      checks: ${{ steps.set-matrix.outputs.checks }}
    steps:
      - uses: actions/checkout@f548e57e544e1ff5a4c46bf1e1b8685f8e4a348a # v7.0.1
      - name: Set up the locked Node toolchain
        id: node
        uses: ./.github/actions/setup-pm
        with:
          toolchain: node

      # setup-pm caches npm downloads, not the installed workspace tree.
      # Cache the installed tree itself, keyed on the lockfile, and skip
      # ``npm ci`` on an exact hit. No restore-keys: a partial hit would leave
      # a stale tree, so anything but an exact lockfile match reinstalls from
      # scratch. The discovery job installs with --ignore-scripts, so its tree
      # differs from the check jobs' — hence the distinct ``-noscripts`` key.
      - name: Restore node_modules
        id: node-modules-cache
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            node_modules
            apps/*/node_modules
            ui-tui/node_modules
            ui-tui/packages/*/node_modules
            tests-js/node_modules
            web/node_modules
          key: node-modules-noscripts-${{ runner.os }}-${{ runner.arch }}-node${{ steps.node.outputs.node-version }}-npm${{ steps.node.outputs.npm-version }}-${{ hashFiles('package-lock.json') }}

      - uses: ./.github/actions/retry
        if: steps.node-modules-cache.outputs.cache-hit != 'true'
        with:
          command: npm ci --ignore-scripts

      # Discovery is ``npm query .workspace``. A new package or a new
      # ``check:*`` script needs no change here. An empty list is an error and
      # not an empty matrix, because an empty matrix reports green after it
      # checks nothing.
      - id: set-matrix
        run: |
          node -e '
          const { execSync } = require("child_process");
          const pkgs = JSON.parse(execSync("npm query .workspace", { encoding: "utf-8" }));
          if (pkgs.length === 0) {
            console.error("::error::Workspace discovery produced an empty package list — refusing to emit a zero-length matrix (would skip all JS/TS checks silently).");
            process.exit(1);
          }
          const checks = [];
          for (const pkg of pkgs) {
            const scripts = pkg.scripts || {};
            const subs = Object.keys(scripts).filter(s => /^check:.+$/.test(s));
            if (subs.length > 0) {
              for (const script of subs) {
                checks.push({ package: pkg.location, script });
              }
            } else if (scripts.check) {
              checks.push({ package: pkg.location, script: "check" });
            }
          }
          if (checks.length === 0) {
            console.error("::error::No check scripts found in any workspace package.");
            process.exit(1);
          }
          process.stdout.write("checks=" + JSON.stringify(checks) + "\n");
          ' >> "$GITHUB_OUTPUT"
      - name: Check the checkout is clean
        uses: ./.github/actions/check-clean-worktree

  check:
    name: ${{ matrix.package }} / ${{ matrix.script }}
    needs: workspaces
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      matrix:
        include: ${{ fromJson(needs.workspaces.outputs.checks) }}
      fail-fast: false # report all failures, not just the first one
    steps:
      - uses: useblacksmith/checkout@25227e61ff9dafe400e22fa487b673eac4e4409a  # v1
        with:
          ref: ${{ inputs.commit }}
      - name: Set up the locked JS build toolchain
        id: node
        uses: ./.github/actions/setup-pm
        with:
          # Desktop checks also run Python payload and icon build helpers, and
          # the electron contracts drive real hermes_cli/pm code through
          # HERMES_PYTHON, which needs the application dependencies.
          toolchain: all
          extras: '[]'
          test-environment: 'true'

      # The desktop SSH watchdog tests run their probe through a real zsh
      # login shell (#111949). The ubuntu image ships no zsh and the tests
      # skip without it, so install it here or those legs never run on CI.
      #
      # The desktop portal-session live test drives real Electron windows
      # (electron/portal-session-live.test.ts) and skips without a display,
      # so give the runner a virtual one the same way the Playwright lane does.
      - name: Install zsh and a virtual display for Electron
        if: runner.os == 'Linux'
        # Refresh the package index first, like every other apt step here: a
        # runner image without a populated list can't resolve zsh/libnotify4.
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y zsh xvfb \
            libgtk-3-0 libnotify4 libnss3 libxss1 libxtst6 \
            xdg-utils libatspi2.0-0 libdrm2 libgbm1 libasound2t64

      # setup-pm caches pnpm's store, not the installed workspace tree.
      # The job then links the full workspace node_modules
      # again and runs the native postinstalls again. Electron's binary is
      # prepared explicitly below. This caches the installed tree itself, keyed on the
      # lockfile, and skips ``pnpm install`` on an exact hit. There are no
      # restore-keys: a partial hit leaves a stale tree, so anything other
      # than an exact lockfile match reinstalls from the start.
      #
      # This install runs WITH scripts, so the tree holds native lifecycle
      # artifacts and the explicitly prepared Electron dist, both inside the cached tree.
      #
      # The ~/.cache/electron download cache stays out of the key on purpose.
      # ``pnpm install`` is skipped on a hit, so nothing reads that cache. It only
      # makes the archive larger.
      - name: Restore node_modules
        id: node-modules-cache
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            node_modules
            apps/*/node_modules
            ui-tui/node_modules
            ui-tui/packages/*/node_modules
            tests-js/node_modules
            web/node_modules
          key: node-modules-scripts-${{ runner.os }}-${{ runner.arch }}-node${{ steps.node.outputs.node-version }}-pnpm${{ steps.node.outputs.pnpm-version }}-${{ hashFiles('pnpm-lock.yaml', 'pnpm-workspace.yaml') }}

      # Vitest records each file's duration and result under
      # node_modules/.vite/vitest and orders the next run from it, longest first.
      # The run that misses the cache writes it before the post step saves the
      # tree, so every hit until the next lockfile change replays that one run's
      # order: the slowest jsdom suites all start cold together and starve the
      # rest past their 15s timeout. Drop it so each run orders from scratch.
      - name: Drop vitest run history from the restored tree
        run: rm -rf node_modules/.vite/vitest apps/*/node_modules/.vite/vitest ui-tui/node_modules/.vite/vitest ui-tui/packages/*/node_modules/.vite/vitest tests-js/node_modules/.vite/vitest web/node_modules/.vite/vitest

      # No --trust-lockfile: this install is the gate that checks every locked
      # version against pnpm-workspace.yaml's release-age policy.
      - uses: ./.github/actions/retry
        if: steps.node-modules-cache.outputs.cache-hit != 'true'
        with:
          command: just js-install

      # The cached tree is keyed on the lockfile alone, so an exact hit proves
      # nothing about the manifests. This checks the lockfile still matches
      # every package.json and passes the release-age policy, without
      # touching node_modules.
      - name: Check the lockfile against the manifests and policy
        if: steps.node-modules-cache.outputs.cache-hit == 'true'
        run: pnpm install --frozen-lockfile --lockfile-only

      # tests-js/pnpm-workspace-policy.test.mjs reads pnpm-workspace.yaml after the install above; an
      # install that rewrites it (an exclude prune, say) would hide what was committed, and the
      # clean-checkout step at the end only warns.
      - name: Check the install kept pnpm-workspace.yaml as committed
        run: git diff --exit-code -- pnpm-workspace.yaml

      - name: Prepare locked Electron runtime before parallel checks
        run: just electron-runtime

      # The WhatsApp bridge is a standalone npm package, outside the root
      # workspaces, so run-workspace-checks never sees it. Two of its suites
      # import @whiskeysockets/baileys, so install its own lockfile first;
      # --ignore-scripts because the tests need no native build.
      - name: Install WhatsApp bridge dependencies
        uses: ./.github/actions/retry
        with:
          command: just js-install-whatsapp-bridge
      - name: Run WhatsApp bridge node tests
        run: just test-whatsapp-bridge

